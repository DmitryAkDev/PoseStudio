# Base model config for the i18n tools. Copy to .env and fill in.
# A locale may override any of these keys in locales/<lang>/.env
# (the overlay wins on a key-by-key basis).
API_BASE=http://server:port/v1
MODEL=ModelName
TEMPERATURE=0.5

# Optional, for hybrid reasoning models: skip the chain-of-thought pass
# entirely (10-50x faster per label) — see README "NO_THINKING".
# NO_THINKING=1
# REASONING_EFFORT=low
