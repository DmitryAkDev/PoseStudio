# Shared LLM model pool. The DEFAULT entry is used for every language
# that has no MODEL= of its own in locales/<lang>/.env.
LLM_MODEL_DEFAULT_API_BASE=http://server:port/v1
LLM_MODEL_DEFAULT_MODEL=ModelName
LLM_MODEL_DEFAULT_TEMPERATURE=0.5

# Role → pool entry, set per locale in locales/<lang>/.env (optional; an unset role falls back to the DEFAULT entry):
#   MODEL=<NAME>        — translator: translate.py
